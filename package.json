    "pino": "10.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^5.12.0",
    "semantic-release": "^24.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
