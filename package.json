{
  "name": "vedic-rajkumar",
  "private": true,
  "version": "0.0.0-development",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run flags:gen",
    "preview": "vite preview",
    "lint": "eslint src supabase/functions vite.config.ts vitest.config.ts playwright.config.ts tailwind.config.ts --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:core": "vitest run src/tests/featureRegistryNav.test.ts src/tests/services/ephemerisService.test.ts src/tests/services/vedicAstroEngine.test.ts",
    "validate:accuracy": "vitest run src/tests/validation/accuracySuite.test.ts --reporter=verbose",
    "test:a11y": "vitest run src/tests/week5/accessibilityGaps.test.tsx",
    "test:perf": "lhci autorun --config=.lighthouserc.json",
    "ci:core": "npm run test:core && npm run build",
    "test:e2e": "playwright test",
    "shots": "playwright test --config playwright.screenshots.config.ts",
    "shots:live": "node scripts/shots-live.mjs",
    "migrate:chart-tz": "node scripts/migrate-chart-tz.mjs",
    "migrate:chart-tz:write": "node scripts/migrate-chart-tz.mjs --write",
    "test:accuracy:fast": "vitest run src/tests/timeScales.test.ts src/tests/nakshatraEdge.test.ts src/tests/chartCacheKey.test.ts src/tests/vimshottari.test.ts src/tests/birthTimezone.test.ts",
    "test:time": "vitest run src/tests/timeScales.test.ts src/tests/bodyFrame.test.ts --reporter=verbose",
    "time:verify": "npm run test:time",
    "test:accuracy:moon": "vitest run src/tests/accuracy/moonFlipAudit.test.ts --reporter=verbose",
    "moon:audit": "npm run test:accuracy:moon",
    "moon:verify": "vitest run src/tests/moonSeries.test.ts src/tests/moonWiring.test.ts",
    "accuracy:golden": "node scripts/accuracy-golden.mjs",
    "accuracy:shadbala-golden": "node scripts/accuracy-shadbala-golden.mjs",
    "test:accuracy:full": "vitest run src/tests/accuracy/corpusPhase1.test.ts --reporter=verbose",
    "test:accuracy:corpus": "vitest run src/tests/accuracy/corpusPhase1.test.ts --reporter=verbose",
    "test:accuracy:shadbala": "vitest run src/tests/accuracy/shadbala.analytic.test.ts src/tests/accuracy/shadbala.varga.test.ts src/tests/accuracy/shadbala.corpus.test.ts src/tests/accuracy/shadbala.tz-wiring.test.ts src/tests/accuracy/shadbala.golden.test.ts src/tests/accuracy/unverifiedDoc.test.ts --reporter=verbose --hookTimeout=2000",
    "test:tz-wiring": "vitest run src/tests/chartTimezoneWiring.test.ts",
    "test:coverage": "vitest run --coverage",
    "accuracy:publish": "node scripts/publish-accuracy.mjs",
    "answers:emit": "node scripts/emitAnswerCards.mjs",
    "answers:check": "node scripts/emitAnswerCards.mjs --check",
    "answers:html": "node scripts/prerenderAnswers.mjs",
    "answers:html:check": "node scripts/prerenderAnswers.mjs --check",
    "docs:verify": "node scripts/verify-claims.mjs",
    "test:tiers": "playwright test --config playwright.tiers.config.ts",
    "test:tiers:headed": "playwright test --config playwright.tiers.config.ts --headed",
    "test:tiers:report": "node scripts/tier-report.mjs",
    "test:parity": "playwright test --config playwright.tiers.config.ts --grep @parity",
    "test:db": "supabase test db",
    "test:billing": "playwright test --config playwright.tiers.config.ts --grep @billing",
    "duplicates:check": "node scripts/check-duplicates.mjs",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "openapi:check": "tsx scripts/emit-openapi.ts && git diff --exit-code docs/api/openapi.yaml",
    "test:ratelimit": "vitest run src/tests/api/rateLimit.test.ts",
    "prune:buckets": "supabase db execute --sql \"select public.prune_rate_limit_buckets(60)\"",
    "alerts:emit": "node scripts/emit-alerts.mjs",
    "alerts:check": "node scripts/emit-alerts.mjs && git diff --exit-code observability/alerts/alerts.yml",
    "status:emit": "node scripts/emit-status.mjs",
    "prune:observability": "supabase db execute --sql \"select public.prune_observability()\"",
    "licenses:check": "node scripts/check-licenses.mjs",
    "test:a11y:axe": "vitest run src/tests/a11y/axe.test.tsx",
    "erasure:verify": "supabase db execute --sql \"select public.verify_erasure_chain(:id)\"",
    "retention:apply": "supabase db execute --sql \"select public.apply_retention()\"",
    "dco:check": "node scripts/check-dco.mjs",
    "commitlint": "commitlint --edit",
    "protection:check": "node scripts/apply-branch-protection.mjs --check",
    "protection:apply": "node scripts/apply-branch-protection.mjs",
    "release": "semantic-release",
    "budget:check": "node scripts/bundle-budget.mjs",
    "budget:update": "npm run build && node scripts/bundle-budget.mjs --update-baseline",
    "audit:routes": "node scripts/audit-routes.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:perf:mobile": "playwright test tests/e2e/perf-mobile.spec.ts --project=chromium",
    "lhci": "lhci autorun",
    "dr:drill": "node scripts/dr-restore-drill.mjs",
    "dr:drill:dry": "node scripts/dr-restore-drill.mjs --dry-run",
    "dr:readiness": "supabase db execute --sql \"select jsonb_pretty(public.dr_readiness())\"",
    "dr:backup-health": "supabase db execute --sql \"select * from public.backup_health()\"",
    "gtm:audit": "node scripts/gtm-audit.mjs",
    "funnel:parity": "node scripts/funnel-parity.mjs",
    "funnel:summary": "supabase db execute --sql \"select jsonb_pretty(public.funnel_summary())\"",
    "deploy:safety": "node scripts/deploy-safety.mjs",
    "deploy:rollback": "node scripts/deploy-rollback.mjs",
    "flags:gen": "node scripts/gen-flags.mjs",
    "content:golden:sync": "node scripts/content-golden-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "incident:new": "node scripts/new-incident.mjs",
    "deploy:edge:production": "supabase functions deploy",
    "smoke:edge": "node scripts/smoke-edge.mjs",
    "rollback:edge": "node scripts/rollback-edge.mjs",
    "drill:restore": "node scripts/drill-restore.mjs",
    "drill:killswitch": "node scripts/drill-killswitch.mjs",
    "deploy:production": "npm run ship && npx netlify deploy --prod --dir=dist",
    "typecheck:edge": "deno check supabase/functions/**/index.ts",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "ship": "npm run accuracy:publish && npm run answers:emit && npm run answers:html && npm run build"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@clerk/react": "^6.14.3",
    "@clerk/themes": "^2.4.57",
    "@flagsmith/flagsmith": "12.4.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.5",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.5",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-hover-card": "^1.1.5",
