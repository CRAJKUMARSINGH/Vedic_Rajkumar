VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_USE_SWISS_EPHEMERIS=false
# Optional — add your Sentry DSN to enable error monitoring in production
VITE_SENTRY_DSN=
# Optional — app version string forwarded to Sentry releases
VITE_APP_VERSION=0.1.0

# Feature Flags (Flagsmith) — Week 3
# Get your environment key from https://flagsmith.com → Project → Environments
# Leave blank to run in static/default mode (all core features on, premium features off)
VITE_FLAGSMITH_ENV_ID=

# API Configuration — Week 2
# Set to true to route calculations through Supabase Edge Functions instead of client-side
VITE_USE_EDGE_API=false

# PostHog Analytics — Week 7
# Get your project API key from https://app.posthog.com → Project → Settings
# Leave blank to disable analytics (dev/offline mode)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
# Set to true to force PostHog capture in dev (default: off in dev)
VITE_POSTHOG_FORCE_ENABLE=false

# Observability — Week 9
VITE_LOG_LEVEL=info
VITE_RELEASE_VERSION=dev
LOGTAIL_SOURCE_TOKEN=

# Transactional Email — Gap 2 (Resend)
# Get your API key from https://resend.com → API Keys
# Used by supabase/functions/send-email/index.ts (server-side only)
RESEND_API_KEY=

# Edge Ephemeris — Week 8 bundle optimisation
# Set to true to exclude swisseph-wasm from the client bundle (uses edge function instead)
VITE_USE_EDGE_EPHEMERIS=false

# Emergency kill switches — set true to disable a feature instantly
VITE_KILL_KUNDLI=false
VITE_KILL_MATCH=false
VITE_KILL_PDF=false
VITE_KILL_API=false
VITE_KILL_TRANSITS=false
